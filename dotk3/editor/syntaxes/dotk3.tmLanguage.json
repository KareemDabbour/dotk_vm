{
  "name": "DotK 3",
  "scopeName": "source.dotk3",
  "patterns": [
    { "name": "comment.line.number-sign.dotk3", "match": "#.*$" },
    { "include": "#strings" },
    {
      "match": "\\b(record|class|trait|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.dotk3" },
        "2": { "name": "entity.name.type.dotk3" }
      }
    },
    {
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.function.dotk3" },
        "2": { "name": "entity.name.function.dotk3" }
      }
    },
    {
      "match": "\\b([A-Z][A-Za-z0-9_]*)\\.([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "entity.name.type.dotk3" },
        "2": { "name": "constant.other.enum.dotk3" }
      }
    },
    { "name": "keyword.control.dotk3", "match": "\\b(?:let|var|fn|constructor|record|class|public|protected|private|static|extends|trait|impl|implements|if|else|while|for|in|return|yield|throw|defer|break|continue|try|catch|finally|import|from|as|is|type|export|match|and|or|not|enum)\\b" },
    { "name": "variable.language.dotk3", "match": "\\b(?:self|super)\\b" },
    { "name": "constant.language.dotk3", "match": "\\b(?:true|false|null)\\b" },
    { "name": "support.type.dotk3", "match": "\\b(?:Object|Int|Float|Bool|String|Bytes|Null|List|Tuple|Map|Set|Iterable|Generator|Task|Resource|Error)\\b" },
    { "name": "support.class.module.dotk3", "match": "\\b(?:System|IO|Reflection|Collections|Text|Math|Tasks|Files|Json|Random|Terminal|Sockets|Http|Requests)\\b" },
    { "name": "support.function.dotk3", "match": "\\b(?:print|len|type|members|binding|bindings|str|range|encode|decode|toInt|toFloat|gc|close|spawn|pump|cancel)\\b" },
    { "name": "constant.numeric.dotk3", "match": "\\b(?:0x[0-9A-Fa-f_]+|0b[01_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?)\\b" },
    { "name": "keyword.operator.dotk3", "match": "=>|->|\\?\\?|==|!=|<=|>=|&&|\\|\\||//|[-+*/%<>=!?:&]" }
  ],
  "repository": {
    "strings": {
      "patterns": [
        { "name": "string.quoted.double.formatted.dotk3", "begin": "\\bf\"", "end": "\"|$", "patterns": [{ "include": "#escapes" }] },
        { "name": "string.quoted.single.formatted.dotk3", "begin": "\\bf'", "end": "'|$", "patterns": [{ "include": "#escapes" }] },
        { "name": "string.quoted.triple.double.dotk3", "begin": "\"\"\"", "end": "\"\"\"", "patterns": [{ "include": "#escapes" }] },
        { "name": "string.quoted.triple.single.dotk3", "begin": "'''", "end": "'''", "patterns": [{ "include": "#escapes" }] },
        { "name": "string.quoted.double.bytes.dotk3", "begin": "\\bb\"", "end": "\"|$", "patterns": [{ "include": "#escapes" }] },
        { "name": "string.quoted.single.bytes.dotk3", "begin": "\\bb'", "end": "'|$", "patterns": [{ "include": "#escapes" }] },
        { "name": "string.quoted.double.dotk3", "begin": "\"", "end": "\"|$", "patterns": [{ "include": "#escapes" }] },
        { "name": "string.quoted.single.dotk3", "begin": "'", "end": "'|$", "patterns": [{ "include": "#escapes" }] }
      ]
    },
    "escapes": { "patterns": [{ "name": "constant.character.escape.dotk3", "match": "\\\\(?:[nrt0\\\\\"']|x[0-9A-Fa-f]{2})" }] }
  }
}