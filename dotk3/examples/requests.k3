fn show(response: Map<String, Object?>) -> Null {
    System.print(response["status"], response["reason"], response["url"])
}

if System.args.length() == 0 { System.print("requests: use --net requests.k3 https://api.github.com/zen") }
else {
    let response = Requests.get(System.args[0], {"headers": {"Accept": "application/json"}, "params": {"per_page": 2}})
    show(response)
    let contentType = (response["headers"] as Map<String, Object?>)["content-type"] as String
    if (response["ok"] as Bool) and contentType.startsWith("application/json") {
        System.print(Json.stringify(Requests.json(response)))
    } else { IO.write(response["body"] as String) }
}
