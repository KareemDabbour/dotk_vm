from pacman_model import PacMan

fn play() -> Null {
    var game = PacMan()
    var running = true
    var escape = 0
    var dirty = true
    var previous = System.monotonicMillis()
    IO.Terminal.open()
    defer IO.Terminal.close()
    IO.write("\x1b[2J\x1b[?25l")
    defer IO.write("\x1b[0m\x1b[?25h\n")
    while running {
        if dirty { IO.write("\x1b[H" + game.render() + "\x1b[J"); dirty = false }
        let key = IO.Terminal.readKey(10)
        if key != null {
            dirty = true
            if key == 3 or key == 113 { running = false }
            else if key == 27 { escape = 1 }
            else if escape == 1 { if key == 91 { escape = 2 } else { escape = 0 } }
            else if escape == 2 {
                if key == 65 { game.action("up") }
                else if key == 66 { game.action("down") }
                else if key == 67 { game.action("right") }
                else if key == 68 { game.action("left") }
                escape = 0
            } else if key == 97 { game.action("left") }
            else if key == 100 { game.action("right") }
            else if key == 119 { game.action("up") }
            else if key == 115 { game.action("down") }
            else if key == 112 { game.action("pause") }
            else if key == 114 { game.action("restart") }
            else if key == 110 { game.action("next") }
            else if key == 32 { game.action("start") }
        }
        let now = System.monotonicMillis()
        if now - previous >= 130 { game.tick(); previous = now; dirty = true }
        # System.gc()
    }
}

if System.args.length() > 0 { play() }
else {
    let game = PacMan()
    game.action("right")
    game.tick()
    System.print(f"Pac-Man ready: score={game.score}, pellets={game.pellets}")
}