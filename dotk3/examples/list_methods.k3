from System import print

record Entry { value: Int }
let entries: List<Entry> = [Entry(1), Entry(3)]
entries.insert(1, Entry(2))
let removed: Entry = entries.removeAt(-1)
print(removed, entries)

fn more() {
    yield Entry(4)
    System.gc()
    yield Entry(5)
}

entries.extend(more())
entries.extend(entries)
print(entries)
let insert = entries.insert
System.gc()
insert(entries.length(), Entry(6))
print(entries.removeAt(0).value, entries.length())
print(Reflection.members(entries))