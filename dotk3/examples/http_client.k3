fn request(host: String, port: Int, path: String) -> Null {
    let client = Sockets.connect(host, port, 1000)
    defer Sockets.close(client)
    Http.writeRequest(client, "GET", path)
    let response = Http.readResponse(client)
    if response == null { throw Error(Error.Kind.IO, "No HTTP response") }
    System.print(response["status"])
    IO.write(response["body"] as Bytes)
}

if System.args.length() == 0 { System.print("http_client: use --net http_client.k3 127.0.0.1 8080 /health") }
else {
    if System.args.length() != 3 { throw Error(Error.Kind.Value, "Expected host, port and path") }
    request(System.args[0], Json.parse(System.args[1]) as Int, System.args[2])
}


