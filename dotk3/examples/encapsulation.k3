from System import print

class Inventory extends List<String> {
    private let owner: String
    protected var changes: Int = 0
    private static let category: String = "inventory"

    public constructor(owner: String) -> Null {
        super.init()
        self.owner = owner
    }

    public fn append(value: String) -> Null {
        super.append(value)
        self.changes += 1
    }

    public fn describe() -> String {
        return self.owner + " / " + Inventory.category + " / " + Text.str(self.length())
    }

    public fn reader() -> fn() -> String {
        return fn() -> String { return self.owner }
    }
}

class LoggedInventory extends Inventory {
    public fn countChanges() -> Int { return self.changes }
}

let inventory = LoggedInventory("Ada")
inventory.append("compass")
inventory.append("rope")
let reader = inventory.reader()
GC.collect()
print(inventory.describe(), inventory.countChanges(), reader())
print(Reflection.members(inventory))