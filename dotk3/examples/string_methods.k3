from System import print

let text = "alpha::beta::::gamma::"
print(text.contains("beta"), text.startsWith("alpha"), text.endsWith("::"))
print(text.find("beta"), text.find("missing"))
let parts: List<String> = text.split("::")
print(parts, parts.length())
print("|".join(parts))

fn labels() {
    yield "first"
    GC.collect()
    yield "second"
}
let join = " / ".join
GC.collect()
print(join(labels()))
print(Reflection.members(text))