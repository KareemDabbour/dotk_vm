from System import print

class Scores extends Object {
    private let values: Map<String, Int> = {}
    fn __getitem__(name: String) -> Int { return self.values.get(name) ?? 0 }
    fn __setitem__(name: String, value: Int) -> Null { self.values[name] = value }
}

let scores = Scores()
scores["Ada"] = 10
scores["Ada"] += 5
let value: Object = scores
let optional: Object? = null
print(f"Ada's score is {scores['Ada']}; escaped braces: {{score}}")

try { [1][10] } catch error {
    if error.kind == Error.Kind.Index { print(f"Caught {error.kind}: {error.message}") }
}

IO.write("IO without an implicit newline: ")
print(f"clock={System.monotonicMillis()}")
if System.args.length() > 0 {
    IO.write("Name: ")
    let name: String? = IO.readLine()
    print(f"Hello {name ?? 'Guest'}")
}