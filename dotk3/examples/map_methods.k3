from System import print

record Entry { value: Int }
let entries: Map<String, Entry?> = {
    "first": Entry(1),
    "empty": null,
    "last": Entry(3)
}

print(entries.contains("empty"), entries.contains("missing"))
let keys = entries.keys()
let values = entries.values()
print(entries.remove("empty"), entries.remove("empty"))
entries["new"] = Entry(4)
System.gc()
print(keys, values)
print(entries.keys(), entries.values())
for key in entries.keys() { print(key, entries[key]) }
print(Reflection.members(entries))

let counters: Map<String, Int> = {}
print(counters.computeIfAbsent("visits", fn(key: String) -> Int => 0))
print(counters.compute("visits", fn(key: String, previous: Int?) -> Int => (previous ?? 0) + 1))
print(counters.computeIfPresent("visits", fn(key: String, previous: Int) -> Int => previous + 1))
print(counters.putIfAbsent("visits", 99))
print(counters.merge("visits", 3, fn(previous: Int, added: Int) -> Int => previous + added))
counters.compute("visits", fn(key: String, previous: Int?) -> Int? => null)
print(counters.contains("visits"))